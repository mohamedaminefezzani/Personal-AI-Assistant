DATABASE_URL=your_postgres_connection_string
JWT_SECRET=your_jwt_secret_run_openssl_rand_hex_32
TAVILY_API_KEY=your_tavily_api_key
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key

# Directory where the assistant saves and reads files (default: ~/assistant_files)
FILES_BASE_DIR=~/assistant_files

# Maximum duration of one generation, including tool calls and summarisation.
TASK_TIMEOUT_SECONDS=900
# HTTP request timeout; the task deadline still covers all model/tool calls together.
OLLAMA_HTTP_TIMEOUT_SECONDS=900
MAIN_MODEL=qwen3.5:9b
CODING_MODEL=qwen3.5:4b
VIDEO_MODEL=ministral-3:3b
SUMMARY_MODEL=ministral-3:3b
SUMMARY_NUM_PREDICT=512
SUMMARY_TIMEOUT_SECONDS=240
SUMMARY_SAVE_TIMEOUT_SECONDS=20
OLLAMA_NUM_CTX=8192
# Video frames require a larger context and can use more RAM.
OLLAMA_VIDEO_NUM_CTX=32768
OLLAMA_NUM_PREDICT=1024
OLLAMA_NUM_THREAD=6
OLLAMA_KEEP_ALIVE=5m
SEARCH_MAX_RESULTS=3
SEARCH_RESULT_CHARS=1200
